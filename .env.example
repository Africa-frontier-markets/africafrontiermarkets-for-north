# AFRICA FRONTIER MARKETS — PRODUCTION CONFIG

# Security (REQUIRED: SECRET_KEY >= 48 characters)
# AFM Configuration — local/dev reference.
# On Render, all of this is provisioned automatically by render.yaml;
# you only need to fill in the `sync: false` values in the dashboard
# during the Blueprint deploy flow (PSP keys, ALLOWED_ORIGINS, etc).

SECRET_KEY=change-me-to-64-char-random-hex-string-here-now-immediately
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql+asyncpg://afm_user:strong_password@postgres:5432/africa_frontier_markets
# Database — accepts postgresql://, postgres://, or postgresql+asyncpg://
# (Render injects postgresql://; common/db_url.py normalizes it).
DATABASE_URL=postgresql+asyncpg://afm_user:strong_password@postgres:5432/afm
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Redis (Rate limiting, sessions, events)
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=50

# Payment Providers (LIVE KEYS — NEVER COMMIT)
KORA_API_KEY=pk_live_kora_...
KORA_SECRET_KEY=sk_live_kora_...
FINCRA_API_KEY=pk_live_fincra_...
FINCRA_SECRET_KEY=sk_live_fincra_...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
FLUTTERWAVE_SECRET_KEY=FLWSECK-...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# FrontierPay Webhook Secrets (HMAC verification)
KORA_WEBHOOK_SECRET=whsec_kora_...
FINCRA_WEBHOOK_SECRET=whsec_fincra_...

# Platform
ENVIRONMENT=production
LOG_LEVEL=INFO
JSON_LOGS=true

# CORS (Strict in production)
ALLOWED_ORIGINS=https://app.africafrontiermarkets.com,https://admin.africafrontiermarkets.com

# Revenue Split
ADS_SHARE=0.35
CREATOR_SHARE=0.50
PLATFORM_SHARE=0.15

# Feature Flags
ENABLE_COPY_TRADING=true
ENABLE_SOCIAL_TRADING=true
MAX_COPY_ALLOCATION_PERCENT=100
# Redis
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=50

# Payment Providers — REPLACE WITH REAL KEYS
KORA_API_KEY=pk_live_kora_REPLACE_ME
KORA_SECRET_KEY=sk_live_kora_REPLACE_ME
FINCRA_API_KEY=pk_live_fincra_REPLACE_ME
FINCRA_SECRET_KEY=sk_live_fincra_REPLACE_ME
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-REPLACE_ME
FLUTTERWAVE_SECRET_KEY=FLWSECK-REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Legacy Alpaca Broker API — Broker Client ID / Client Secret (never commit real values)
ALPACA_API_KEY=replace_with_broker_client_id
ALPACA_SECRET_KEY=replace_with_broker_client_secret
ALPACA_PAPER=true
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_AUTH_URL=https://authx.sandbox.alpaca.markets/v1/oauth2/token

# Alpaca Trading API — dedicated Trading key pair (never reuse Broker OAuth credentials)
ALPACA_TRADING_API_KEY=replace_with_trading_api_key_id
ALPACA_TRADING_API_SECRET=replace_with_trading_api_secret_key
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADING_MARKET_DATA_BASE_URL=https://data.alpaca.markets

# Webhooks — REPLACE WITH REAL SECRETS
KORA_WEBHOOK_SECRET=whsec_kora_REPLACE_ME
FINCRA_WEBHOOK_SECRET=whsec_fincra_REPLACE_ME

# Published legal documents and internal KYC1 policy
TERMS_VERSION=2026-08-27
AML_POLICY_VERSION=2.1
KYC1_MONTHLY_LIMIT_XAF=10000000

# User onboarding — production requires a real transactional mailbox; never commit values
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_mailbox_username
SMTP_PASSWORD=replace_with_mailbox_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
SMS_API_URL=https://sms-provider.example/v1/messages
SMS_API_TOKEN=replace_with_sms_provider_token
SMS_SENDER=AFM
WHATSAPP_ACCESS_TOKEN=replace_with_meta_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=afm_authentication_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=fr
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_EXPOSE_DEV_CODE=false

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=true

# AFM Revenue
AFM_COMMISSION_BPS=200
AFM_MIN_FEE_USD=0.50
AFM_MAX_FEE_USD=50.00

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Kora Operations
# Set KORA_SANDBOX=true only with a Kora sk_test_ key.
KORA_API_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_SANDBOX=false
# KORA_SECRET_KEY=sk_test_...
# KORA_WEBHOOK_SECRET=...
